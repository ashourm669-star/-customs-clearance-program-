# Local development (already configured in .env)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Hosted deployment ────────────────────────────────────────────────
# Use a managed PostgreSQL URL (Neon / Supabase / Railway / Render / RDS).
# Example (Neon):
# DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Optional: live bill-of-lading / AWB tracking provider (DCSA or aggregator)
# TRACKING_API_URL=https://api.shipsgo.com/v2/tracking
# TRACKING_API_KEY=
# TRACKING_API_HEADER=X-Access-Token
# TRACKING_QUERY_PARAM=query
# DCSA_BASE_URL=https://api.maersk.com/track-and-trace/v1
# DCSA_TOKEN_URL=https://api.maersk.com/oauth2/token
# DCSA_CLIENT_ID=
# DCSA_CLIENT_SECRET=

# Optional: Nafeza single-window declarations
# NAFEZA_API_URL=
# NAFEZA_CLIENT_ID=
# NAFEZA_CLIENT_SECRET=
