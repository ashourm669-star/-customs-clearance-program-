# Production: set this in Vercel project Settings > Environment Variables.
# Use a managed PostgreSQL provider (e.g. Neon). Do NOT use 127.0.0.1 on Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: Only configure these after obtaining valid API credentials.
# TRACKINGMORE_API_KEY=
# CARRIER_API_URL=
# CARRIER_LOOKUP_URL=
# CARRIER_API_KEY=
# NAFEZA_API_URL=
# NAFEZA_API_KEY=
